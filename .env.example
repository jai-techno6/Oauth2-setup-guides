# Copy to .env (never commit .env). Only OPENAI_API_KEY is required.
OPENAI_API_KEY=your_openai_api_key_here

# Model used for research (web search) and for writing the guide.
OPENAI_MODEL=gpt-5.4-mini
# low | medium | high. Leave empty for models without reasoning support.
OPENAI_REASONING_EFFORT=low

# Optional: lets the agent check Composio's live toolkit catalog for managed OAuth.
COMPOSIO_API_KEY=

# Optional: if set, live generation asks for this code (protects your OpenAI bill on a public URL).
ACCESS_CODE=

# Max live generations per IP per hour, and how many can run at once.
GENERATE_RATE_PER_HOUR=10
MAX_CONCURRENT_JOBS=3

# Where generated guides are stored (SQLite). On Railway, mount a volume here.
DATA_DIR=./var
